# PayPal sandbox REST app on a US business account (developer.paypal.com).
# Enable Payouts, Vault and Transaction search on the app. PAYPAL_ENV=live is refused.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=

# Webhook id from the app's Webhooks section; only needed to receive PayPal webhooks.
PAYPAL_WEBHOOK_ID=

# libSQL database: a local file by default, or a Turso URL plus auth token.
DATABASE_URL=file:data/agritranche.db
DATABASE_AUTH_TOKEN=

# Signs the photo challenge codes; any random string of 32+ characters (openssl rand -hex 32).
CHALLENGE_SECRET=

# Gemini for the evidence oracle (aistudio.google.com/apikey). Without a key, or with AI_MODE=replay,
# only recorded readings are used and anything else is held for human review.
GOOGLE_GENERATIVE_AI_API_KEY=
# Or Gemini through Vertex AI with Google Cloud credentials (gcloud auth application-default login).
AI_PROVIDER=google
GOOGLE_VERTEX_PROJECT=
GOOGLE_VERTEX_LOCATION=global
# Optional: local file with a temporary token grant, used instead of gcloud credentials.
GOOGLE_TOKEN_GRANT_FILE=
AI_MODE=live
AI_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash
AI_DAILY_LIMIT=400

# Offer the plot's own location to farmers testing from elsewhere (hosted demo for judges).
DEMO_MODE=false

# Sandbox account logins: the buyer approves PayPal checkouts, the farmer receives payouts.
SANDBOX_BUYER_EMAIL=
SANDBOX_BUYER_PASSWORD=
SANDBOX_FARMER_EMAIL=
SANDBOX_FARMER_PASSWORD=
SANDBOX_FARMER_2_EMAIL=
SANDBOX_DEALER_EMAIL=
# The labour group and machinery hire paid from harvest and crop-care bills.
SANDBOX_LABOUR_EMAIL=
SANDBOX_MACHINERY_EMAIL=

# npm run prefetch:geo: free key from data-api.globalforestwatch.org for tree cover loss checks
GFW_API_KEY=

# npm run evidence: a buyer-filed sandbox dispute to send evidence to
EVIDENCE_DISPUTE_ID=

# Compliance workspace billing plan id, printed by npm run paypal:plan.
PAYPAL_WORKSPACE_PLAN_ID=

# Shared secret for scheduled jobs (reconciliation); any random string of 16+ characters.
CRON_SECRET=

# Hosted demo: buyer and cooperative actions need this passcode, entered once at /unlock. Leave blank locally.
DEMO_PASSCODE=

# Optional: AG Studio licence key for the command centre (without it, a trial watermark shows).
AG_STUDIO=

# Model for the command centre's agent.
AGENT_MODEL=gemini-3.8-flash
