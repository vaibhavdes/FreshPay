# PayPal sandbox REST app on a US business account (developer.paypal.com).
# Enable Payouts, Vault and Transaction search on the app. PAYPAL_ENV=live is refused.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=

# Webhook id from the app's Webhooks section; only needed to receive PayPal webhooks.
PAYPAL_WEBHOOK_ID=

# libSQL database: a local file by default, or a Turso URL plus auth token.
DATABASE_URL=file:data/agritranche.db
DATABASE_AUTH_TOKEN=

# Signs the photo challenge codes; any random string of 32+ characters (openssl rand -hex 32).
CHALLENGE_SECRET=

# Sandbox account logins: the buyer approves PayPal checkouts, the farmer receives payouts.
SANDBOX_BUYER_EMAIL=
SANDBOX_BUYER_PASSWORD=
SANDBOX_FARMER_EMAIL=
SANDBOX_FARMER_PASSWORD=

# npm run evidence: a buyer-filed sandbox dispute to send evidence to
EVIDENCE_DISPUTE_ID=

# Optional: AG Studio licence key for /dashboard.
AG_STUDIO=

# Optional: the AG Studio AI assistant on /dashboard. If blank, an OPENAI_API_KEY already in
# your environment is used instead; with neither, the assistant is hidden.
AG_STUDIO_OPENAI_API_KEY=

# Comma-separated OpenAI model ids for the assistant's model picker; the first is the default.
# If blank, gpt-5.4-mini is used as the default, and no model switcher options are available.
OPENAI_MODELS=gpt-5.6-terra,gpt-5.6-luna,gpt-5.6-sol
