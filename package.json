{
  "name": "farmproof",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "evidence": "tsx --env-file=.env.local scripts/sandbox-evidence.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "doctor": "tsx --env-file=.env.local scripts/doctor.ts",
    "seed": "tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "prefetch:geo": "tsx --env-file=.env.local scripts/prefetch-geo.ts",
    "farms:osm": "tsx scripts/fetch-osm-farms.ts",
    "find-loss": "tsx --env-file=.env.local scripts/find-loss.ts",
    "eval:agent": "tsx --env-file=.env.local scripts/eval-review-agent.ts",
    "paypal:plan": "tsx --env-file=.env.local scripts/create-workspace-plan.ts",
    "replays:export": "tsx --env-file=.env.local scripts/export-replays.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.108",
    "@ai-sdk/google-vertex": "^5.0.127",
    "@libsql/client": "^0.18.0",
    "@paypal/paypal-server-sdk": "^2.5.0",
    "ag-grid-community": "36.2.0",
    "ag-grid-enterprise": "^36.2.0",
    "ag-grid-react": "36.2.0",
    "ag-studio": "3.0.0",
    "ag-studio-react": "3.0.0",
    "ai": "^7.0.157",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "^16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
